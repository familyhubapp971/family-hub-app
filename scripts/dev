#!/usr/bin/env bash
# ./scripts/dev: one-command local development.
#
# Boots the web site via the root `pnpm dev`. The server and its
# database run from the family-hub-api repo (ADR 0021).
#
# Requires: pnpm, .env.local. If .env.local is
# missing it's created from .env.example as a courtesy.

set -euo pipefail

command -v pnpm   >/dev/null || { echo "✗ pnpm not found on PATH"   >&2; exit 1; }

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

if [[ ! -f .env.local ]]; then
  echo "→ .env.local missing: copying from .env.example"
  cp .env.example .env.local
fi

# FHS-688: the server lives in family-hub-api. Start it there first
# (its own scripts bring up Postgres and the api on :3001).
echo "→ Start the server from family-hub-api first (pnpm dev there)."
echo "→ Booting web (:5273): Ctrl-C to stop..."
exec pnpm dev
