{
  "name": "@familyhub/web",
  "version": "0.0.0",
  "private": true,
  "description": "Family Hub web site. Repo root package; the design system lives in design-system/.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "volta": {
    "node": "20.19.0",
    "pnpm": "10.32.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:up": "docker compose up -d --wait",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v && docker compose up -d --wait",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "clean": "rm -rf dist .turbo node_modules/.cache && pnpm -r exec rm -rf dist .turbo node_modules/.cache",
    "prepare": "husky || true",
    "storybook": "pnpm -F @familyhub/ui storybook",
    "build-storybook": "pnpm -F @familyhub/ui build-storybook"
  },
  "dependencies": {
    "@familyhub/shared": "github:familyhubapp971/family-hub-api#shared-rules-v0.1.0&path:shared-rules",
    "@familyhub/ui": "workspace:*",
    "@sentry/react": "^8.55.2",
    "@supabase/supabase-js": "^2.105.1",
    "framer-motion": "^11.18.2",
    "leaflet": "^1.9.4",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@sentry/vite-plugin": "^2.23.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "20.16.11",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "@vitest/coverage-v8": "2.1.4",
    "autoprefixer": "10.4.20",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.36.1",
    "eslint": "9.18.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "hono": "4.6.10",
    "husky": "9.1.7",
    "jose": "^5.10.0",
    "jsdom": "25.0.1",
    "lint-staged": "15.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "8.13.1",
    "postcss": "8.4.47",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.2",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  },
  "packageManager": "pnpm@10.32.0"
}
