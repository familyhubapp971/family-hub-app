{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": ["src/**/*"],
  // Stories are the catalogue, not part of the package's public surface, so
  // they stay out of the declaration build: their inferred Storybook types
  // reference pnpm's isolated store and cannot be named in a .d.ts.
  // tsconfig.stories.json typechecks them instead (FHS-643).
  "exclude": ["src/**/*.stories.tsx"]
}
